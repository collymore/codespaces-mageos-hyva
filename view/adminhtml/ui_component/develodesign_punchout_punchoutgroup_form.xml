			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">DUNS Identity</label>
				<dataScope>duns_identity</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="ariba_network_id" formElement="input" sortOrder="60">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Ariba Network ID</label>
				<dataScope>ariba_network_id</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
				<field name="business_unit" formElement="input" sortOrder="70">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Business Unit</label>
				<dataScope>business_unit</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
        </fieldset>
    </fieldset>

	 <fieldset name="oci">
        <settings>
            <label translate="true">OCI</label>
        </settings>
        <fieldset name="oci_group">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Credentials</item>
                    <item name="collapsible" xsi:type="boolean">true</item>
                    <item name="opened" xsi:type="boolean">false</item>
                </item>
            </argument>
           <field name="oci_username" formElement="input" sortOrder="80">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">OCI Username</label>
				<dataScope>oci_username</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="oci_password" formElement="input" sortOrder="90">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">OCI Password</label>
				<dataScope>oci_password</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
        </fieldset>
    </fieldset>
</form>
