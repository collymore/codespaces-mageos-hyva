	<fieldset name="default_customer">
        <settings>
            <label translate="true">Group Defaults</label>
        </settings>
		<fieldset name="default_customer_group_settings">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Customer Settings</item>
                    <item name="collapsible" xsi:type="boolean">true</item>
                    <item name="opened" xsi:type="boolean">false</item>
                </item>
            </argument>
			<field name="magento_customer_group" formElement="select" sortOrder="105">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
					<item name="default" xsi:type="number">1</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Assigned Customer Group</label>
				<dataScope>magento_customer_group</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
			<formElements>
			<select>
				<settings>
					<options class="Magento\Customer\Ui\Component\Listing\Column\Group\Options"/>
				</settings>
			</select>
		</formElements>
		</field>
		<field name="group_email" formElement="input" sortOrder="30">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Default Email Domain</label>
				 <notice translate="true">If an email isn't found in the incoming request, a customer will be created with a random email with this domain.</notice>
				<dataScope>group_email</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
        </fieldset>

        <fieldset name="default_customer_group">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Customer Address</item>
                    <item name="collapsible" xsi:type="boolean">true</item>
                    <item name="opened" xsi:type="boolean">false</item>
                </item>
            </argument>
			<field name="street" formElement="input" sortOrder="110">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Street Address</label>
				<dataScope>street</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
		<field name="city" formElement="input" sortOrder="120">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">City</label>
				<dataScope>city</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
		<field name="postcode" formElement="input" sortOrder="130">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Postal code</label>
				<dataScope>postcode</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
		<field name="country_id" formElement="select" sortOrder="140">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Country</label>
				<dataScope>country_id</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
			<formElements>
				<select>
					<settings>
						<options class="Magento\Directory\Model\ResourceModel\Country\Collection"/>
					</settings>
				</select>
			</formElements>
		</field>
		<field name="region" formElement="input" sortOrder="150">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<visible>false</visible>
				<label translate="true">Region</label>
				<dataScope>region</dataScope>
			</settings>
		</field>
		<field name="telephone" formElement="input" sortOrder="160">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Phone Number</label>
				<dataScope>telephone</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">true</rule>
				</validation>
			</settings>
		</field>
        </fieldset>
    </fieldset>

	 <fieldset name="cxml">
        <settings>
            <label translate="true">CXML</label>
        </settings>
        <fieldset name="cxml_group">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Credentials</item>
                    <item name="collapsible" xsi:type="boolean">true</item>
                    <item name="opened" xsi:type="boolean">false</item>
                </item>
            </argument>
        		<field name="shared_secret" formElement="input" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Shared Secret</label>
				<dataScope>shared_secret</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="duns_identity" formElement="input" sortOrder="50">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">PunchoutGroup</item>
